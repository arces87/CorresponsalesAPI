  <DataSets>
    <DataSet Name="DataSetPrueba">
      <Query>
        <DataSourceName>DataSourcePrueba</DataSourceName>
        <CommandText>SELECT        Corresponsales.Agente.NombreAgente, Canales.Dispositivo.Imei, Canales.Dispositivo.MacAddress
FROM            Corresponsales.Agente INNER JOIN
                         Canales.Dispositivo ON Corresponsales.Agente.DispositivoId = Canales.Dispositivo.Id</CommandText>
      </Query>
      <Fields>
        <Field Name="NombreAgente">
          <DataField>NombreAgente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Imei">
          <DataField>Imei</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MacAddress">
          <DataField>MacAddress</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
