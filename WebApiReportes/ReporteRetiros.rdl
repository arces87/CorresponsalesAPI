<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSourceCorresponsales">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=DESKTOP-V86PTLD\SQLEXPRESS;Initial Catalog=FBS_Corresponsales_Solidarios_SanFranciscoAmbato</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>14ced533-dd82-4e72-93ca-44574ef0dd58</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Retiros">
      <Query>
        <DataSourceName>DataSourceCorresponsales</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@fechaInicio">
            <Value>=Parameters!fechaInicio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fechaFin">
            <Value>=Parameters!fechaFin.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
Corresponsales.TransaccionRetiro.IdTransaccion, 
Format(Corresponsales.TransaccionRetiro.ValorCaja, '#.00') AS FondoCaja, 
Format(Corresponsales.TransaccionRetiro.FondoNegocio, '#.00') AS FondoNegocio, 
FORMAT(Corresponsales.Transaccion.FechaSistema, 'dd/MM/yyyy HH:mm:ss') AS Fecha,
Corresponsales.Agente.NombreAgente, 
Format((-1)*convert(int,Corresponsales.Transaccion.Valor), '#.00') AS ValorTotal
FROM            
Corresponsales.Transaccion 
INNER JOIN Corresponsales.TransaccionRetiro 
ON Corresponsales.Transaccion.Id = Corresponsales.TransaccionRetiro.IdTransaccion 
INNER JOIN Corresponsales.Agente 
ON Corresponsales.Transaccion.AgenteId = Corresponsales.Agente.Id
WHERE (Corresponsales.Transaccion.FechaSistema &gt;= @fechaInicio) AND (Corresponsales.Transaccion.FechaSistema &lt;= DATEADD(day,1,@fechaFin))
ORDER BY Corresponsales.Transaccion.FechaSistema DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="IdTransaccion">
          <DataField>IdTransaccion</DataField>
          <rd:TypeName>System.Guid</rd:TypeName>
        </Field>
        <Field Name="FondoCaja">
          <DataField>FondoCaja</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FondoNegocio">
          <DataField>FondoNegocio</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NombreAgente">
          <DataField>NombreAgente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ValorTotal">
          <DataField>ValorTotal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!NombreAgente.Value</FilterExpression>
          <Operator>Like</Operator>
          <FilterValues>
            <FilterValue>=”*”+ Parameters!agente.Value   +”*”</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
  </DataSets>
