<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSourceCorresponsales">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=DESKTOP-V86PTLD\SQLEXPRESS;Initial Catalog=FBS_Corresponsales_Solidarios_SanFranciscoAmbato</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>c1c287cc-86da-4af3-85db-6a53dae8ea8e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="UsuariosActivos">
      <Query>
        <DataSourceName>DataSourceCorresponsales</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@rol">
            <Value>=Parameters!rol.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT Seguridad.Usuario.Codigo AS Usuario, Seguridad.Usuario.NombreCompleto, Seguridad.Usuario.CorreoElectronico AS Email, Seguridad.Rol.Nombre AS Rol, Seguridad.Usuario.FechaUltimoCambioContrasenia AS Fecha, CASE Seguridad.Usuario.EstaActivo WHEN 1 THEN 'Activo' WHEN 0 THEN 'Inactivo' END AS Estado
FROM Seguridad.Usuario INNER JOIN
Seguridad.UsuarioRol ON Seguridad.Usuario.Id = Seguridad.UsuarioRol.UsuarioId INNER JOIN
Seguridad.Rol ON Seguridad.UsuarioRol.RolId = Seguridad.Rol.Id
WHERE (Seguridad.Rol.Nombre IN (@rol))</CommandText>
      </Query>
      <Fields>
        <Field Name="Usuario">
          <DataField>Usuario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NombreCompleto">
          <DataField>NombreCompleto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Email">
          <DataField>Email</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Rol">
          <DataField>Rol</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Estado">
          <DataField>Estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!Usuario.Value</FilterExpression>
          <Operator>Like</Operator>
          <FilterValues>
            <FilterValue>=”*”+ Parameters!usuario.Value   +”*”</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="ListaRoles">
      <Query>
        <DataSourceName>DataSourceCorresponsales</DataSourceName>
        <CommandText>SELECT Nombre
FROM Seguridad.Rol
WHERE (Seguridad.Rol.EstaActivo = 1)</CommandText>
      </Query>
      <Fields>
        <Field Name="Nombre">
          <DataField>Nombre</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
