<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSourceCorresponsales">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=DESKTOP-V86PTLD\SQLEXPRESS;Initial Catalog=FBS_Corresponsales_Solidarios_SanFranciscoAmbato</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>e2e6cbc2-3635-4fe3-85c8-8dfb6a9d4ef9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Transacciones">
      <Query>
        <DataSourceName>DataSourceCorresponsales</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@fechaInicio">
            <Value>=Parameters!fechaInicio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fechaFin">
            <Value>=Parameters!fechaFin.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@servicio">
            <Value>=Parameters!servicio.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
Corresponsales.Transaccion.FechaSistema AS Fecha,
U.Codigo AS Usuario,
FORMAT(Corresponsales.Transaccion.Valor,  '#.00') AS ValorRecaudado,
FORMAT(CONVERT(decimal(2,2), JSON_VALUE(LOWER(Corresponsales.Transaccion.Comisiones), '$.agente')), '#.00') AS ComisionAgente,
FORMAT(CONVERT(decimal(2,2), JSON_VALUE(LOWER(Corresponsales.Transaccion.Comisiones), '$.administracioncanal')), '#.00') AS ComisionCanal,
FORMAT(CONVERT(decimal(2,2), JSON_VALUE(LOWER(Corresponsales.Transaccion.Comisiones), '$.cooperativa')), '#.00') AS ComisionCoop,
FORMAT(CONVERT(decimal(2,2), JSON_VALUE(LOWER(Corresponsales.Transaccion.Comisiones), '$.facilito')), '#.00') AS ComisionPagoAgil,
C.Nombre AS Servicio
FROM
Corresponsales.Transaccion
INNER JOIN Nomenclador.Catalogo AS C ON Corresponsales.Transaccion.Tipo = C.Id
CROSS JOIN Corresponsales.Agente
INNER JOIN Seguridad.Usuario AS U ON Corresponsales.Agente.UsuarioId = U.Id
WHERE (Corresponsales.Transaccion.FechaSistema &gt;= @fechaInicio) AND (Corresponsales.Transaccion.FechaSistema &lt;= DATEADD(day,1,@fechaFin)) AND (C.Id IN (@servicio))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Usuario">
          <DataField>Usuario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ValorRecaudado">
          <DataField>ValorRecaudado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComisionAgente">
          <DataField>ComisionAgente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComisionCanal">
          <DataField>ComisionCanal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Servicio">
          <DataField>Servicio</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComisionCoop">
          <DataField>ComisionCoop</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ComisionPagoAgil">
          <DataField>ComisionPagoAgil</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!Usuario.Value</FilterExpression>
          <Operator>Like</Operator>
          <FilterValues>
            <FilterValue>="*"+Parameters!usuario.Value+"*"</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="Servicios">
      <Query>
        <DataSourceName>DataSourceCorresponsales</DataSourceName>
        <CommandText>SELECT Nombre, Id
FROM Nomenclador.Catalogo
WHERE (TipoCatalogoId = '84C279C0-63D2-45F1-B3E3-3D70522AFE65') AND (Nomenclador.Catalogo.EstaActivo = 1)</CommandText>
      </Query>
      <Fields>
        <Field Name="Nombre">
          <DataField>Nombre</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Guid</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
