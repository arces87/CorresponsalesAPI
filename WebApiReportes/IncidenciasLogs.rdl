<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSourceCorresponsales">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=DESKTOP-V86PTLD\SQLEXPRESS;Initial Catalog=FBS_Corresponsales_Solidarios_SanFranciscoAmbato</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>b7ca6a41-20f1-482b-82ae-273f16f1a9ea</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Logs">
      <Query>
        <DataSourceName>DataSourceCorresponsales</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@supervisor">
            <Value>=Parameters!supervisor.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fechaInicio">
            <Value>=Parameters!fechaInicio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fechaFin">
            <Value>=Parameters!fechaFin.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        
TOP (100) 
Canales.[Log].Fecha AS Fecha, 
U2.NombreCompleto AS Supervisor, 
U.NombreCompleto AS Usuario, 
C.Nombre AS TipoIncidencia, 
T.Nombre AS Estado, 
Canales.[Log].JsonDispositivo AS JsonOrigen,
Canales.[Log].JsonLog AS JsonOperacion
FROM            
Corresponsales.Agente AS A 
INNER JOIN Seguridad.Usuario AS U ON A.UsuarioId = U.Id
INNER JOIN Seguridad.Usuario AS U2 ON A.SupervisorId = U2.Id,
Canales.[Log] 
INNER JOIN Nomenclador.Catalogo AS C ON Canales.[Log].TipoAccionId = C.Id 
INNER JOIN Nomenclador.Catalogo AS T ON Canales.[Log].EstadoId = T.Id
WHERE   (U2.NombreCompleto IN (@supervisor)) AND (Canales.[Log].Fecha BETWEEN @fechaInicio AND @fechaFin)</CommandText>
        <Timeout>1</Timeout>
      </Query>
      <Fields>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Supervisor">
          <DataField>Supervisor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Usuario">
          <DataField>Usuario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TipoIncidencia">
          <DataField>TipoIncidencia</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Estado">
          <DataField>Estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="JsonOrigen">
          <DataField>JsonOrigen</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="JsonOperacion">
          <DataField>JsonOperacion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!Usuario.Value</FilterExpression>
          <Operator>Like</Operator>
          <FilterValues>
            <FilterValue>=”*”+ Parameters!usuario.Value   +”*”</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="Supervisor">
      <Query>
        <DataSourceName>DataSourceCorresponsales</DataSourceName>
        <CommandText>SELECT        Seguridad.Usuario.NombreCompleto
FROM            Seguridad.UsuarioRol INNER JOIN
                         Seguridad.Usuario ON Seguridad.Usuario.Id = Seguridad.UsuarioRol.UsuarioId
WHERE        (Seguridad.UsuarioRol.RolId = 'c3399529-96f3-4014-94ce-bf36ee695546')</CommandText>
      </Query>
      <Fields>
        <Field Name="NombreCompleto">
          <DataField>NombreCompleto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
