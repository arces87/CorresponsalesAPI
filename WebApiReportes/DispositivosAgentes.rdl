<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSourceCorresponsales">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=DESKTOP-V86PTLD\SQLEXPRESS;Initial Catalog=FBS_Corresponsales_Solidarios_SanFranciscoAmbato</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>2cf85863-4eb4-4c4a-908b-2abfe5badce4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DispositivosAgentes">
      <Query>
        <DataSourceName>DataSourceCorresponsales</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@EstadoGPS">
            <Value>=Parameters!EstadoGPS.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EstadoAgente">
            <Value>=Parameters!EstadoAgente.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT
Seguridad.Usuario.Codigo AS Usuario, 
Corresponsales.Agente.NombreAgente AS Nombre, 
Corresponsales.Agente.Identificacion AS Cedula, 
T.Nombre AS Estado, 
'Modelo: ' + Canales.Dispositivo.Modelo + ', No. Serie: ' + Canales.Dispositivo.NumeroSerie + ', IMEI: ' + Canales.Dispositivo.Imei AS Dispositivo, 
CASE JSON_VALUE(Corresponsales.Agente.JsonAgente,'$.verificarGeolocalizacion') WHEN 'true' THEN 'Activo' WHEN 'false' THEN 'Inactivo' END AS GPS
FROM            
Corresponsales.Agente 
INNER JOIN Canales.Dispositivo ON Corresponsales.Agente.DispositivoId = Canales.Dispositivo.Id 
INNER JOIN Seguridad.Usuario ON Corresponsales.Agente.UsuarioId = Seguridad.Usuario.Id 
INNER JOIN Nomenclador.Catalogo AS T ON Corresponsales.Agente.EstadoId = T.Id 
INNER JOIN Canales.AgenteGeolocalizacion ON Corresponsales.Agente.Id = Canales.AgenteGeolocalizacion.AgenteId 
LEFT OUTER JOIN Canales.Geolocalizacion ON Canales.AgenteGeolocalizacion.GeolocalizacionId = Canales.Geolocalizacion.Id
WHERE (Corresponsales.Agente.EstaActivo = 1) AND (JSON_VALUE(Corresponsales.Agente.JsonAgente,'$.verificarGeolocalizacion') IN (@EstadoGPS)) AND (T.Nombre IN (@EstadoAgente))</CommandText>
      </Query>
      <Fields>
        <Field Name="Usuario">
          <DataField>Usuario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Nombre">
          <DataField>Nombre</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Cedula">
          <DataField>Cedula</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Estado">
          <DataField>Estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Dispositivo">
          <DataField>Dispositivo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GPS">
          <DataField>GPS</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="EstadosAgentes">
      <Query>
        <DataSourceName>DataSourceCorresponsales</DataSourceName>
        <CommandText>SELECT Nomenclador.Catalogo.Nombre
FROM Nomenclador.Catalogo INNER JOIN
Nomenclador.TipoCatalogo ON Nomenclador.Catalogo.TipoCatalogoId = Nomenclador.TipoCatalogo.Id
WHERE (Nomenclador.TipoCatalogo.Id = '84C279C0-63D2-45F1-B3E3-3D70522AFE64') AND (Nomenclador.Catalogo.EstaActivo = 1)</CommandText>
      </Query>
      <Fields>
        <Field Name="Nombre">
          <DataField>Nombre</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
