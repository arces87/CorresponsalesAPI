  <DataSources>
    <DataSource Name="DataSourceCorresponsales">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=DESKTOP-V86PTLD\SQLEXPRESS;Initial Catalog=FBS_Corresponsales_Solidarios_SanFranciscoAmbato</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>2cf85863-4eb4-4c4a-908b-2abfe5badce4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DispositivosAgentes">
      <Query>
        <DataSourceName>DataSourceCorresponsales</DataSourceName>
        <CommandText>SELECT        Seguridad.Usuario.Codigo AS Usuario, Corresponsales.Agente.NombreAgente AS Nombre, Corresponsales.Agente.Identificacion AS Cedula, Corresponsales.Agente.EstaActivo, 
                         'Modelo: ' + Canales.Dispositivo.Modelo + ', No. Serie: ' + Canales.Dispositivo.NumeroSerie + ', IMEI: ' + Canales.Dispositivo.Imei AS Dispositivo
FROM            Corresponsales.Agente INNER JOIN
                         Canales.Dispositivo ON Corresponsales.Agente.DispositivoId = Canales.Dispositivo.Id INNER JOIN
                         Seguridad.Usuario ON Corresponsales.Agente.UsuarioId = Seguridad.Usuario.Id</CommandText>
      </Query>
      <Fields>
        <Field Name="Usuario">
          <DataField>Usuario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Nombre">
          <DataField>Nombre</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Cedula">
          <DataField>Cedula</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EstaActivo">
          <DataField>EstaActivo</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="Dispositivo">
          <DataField>Dispositivo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
