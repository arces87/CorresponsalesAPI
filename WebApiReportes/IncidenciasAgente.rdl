<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSourceCorresponsales">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=DESKTOP-V86PTLD\SQLEXPRESS;Initial Catalog=FBS_Corresponsales_Solidarios_Tulcan</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>8ecbdefc-2e7a-4b69-a7b8-654ae1f865cd</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="IncidenciasAgente">
      <Query>
        <DataSourceName>DataSourceCorresponsales</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@estado">
            <Value>=Parameters!estado.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@tipoIncidencia">
            <Value>=Parameters!tipoIncidencia.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fechaInicio">
            <Value>=Parameters!fechaInicio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fechaFin">
            <Value>=Parameters!fechaFin.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        Corresponsales.Alerta.Fecha, C.Nombre AS Incidencia, Corresponsales.Agente.NombreAgente, Corresponsales.Alerta.Descripcion, T.Nombre AS Estado, Corresponsales.Alerta.Comentario
FROM            Corresponsales.Agente INNER JOIN
                         Corresponsales.Alerta ON Corresponsales.Agente.Id = Corresponsales.Alerta.AgenteId INNER JOIN
                         Nomenclador.Catalogo AS C ON Corresponsales.Alerta.TipoId = C.Id INNER JOIN
                         Nomenclador.Catalogo AS T ON Corresponsales.Alerta.EstadoId = T.Id
WHERE (T.Nombre IN (@estado)) AND (C.Nombre IN (@tipoIncidencia)) AND (Corresponsales.Alerta.Fecha BETWEEN @fechaInicio AND @fechaFin)</CommandText>
      </Query>
      <Fields>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Incidencia">
          <DataField>Incidencia</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NombreAgente">
          <DataField>NombreAgente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Estado">
          <DataField>Estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Comentario">
          <DataField>Comentario</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="EstadoAlerta">
      <Query>
        <DataSourceName>DataSourceCorresponsales</DataSourceName>
        <CommandText>SELECT        Nombre
FROM            Nomenclador.Catalogo
WHERE        (TipoCatalogoId = '84C279C0-63D2-45F1-B3E3-3D70522AFE67')</CommandText>
      </Query>
      <Fields>
        <Field Name="Nombre">
          <DataField>Nombre</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TipoIncidencia">
      <Query>
        <DataSourceName>DataSourceCorresponsales</DataSourceName>
        <CommandText>SELECT        Nombre
FROM            Nomenclador.Catalogo
WHERE        (TipoCatalogoId = '84C279C0-63D2-45F1-B3E3-3D70522AFE70')</CommandText>
      </Query>
      <Fields>
        <Field Name="Nombre">
          <DataField>Nombre</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
