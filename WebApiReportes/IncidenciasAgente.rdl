  <DataSources>
    <DataSource Name="DataSourceCorresponsales">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=DESKTOP-V86PTLD\SQLEXPRESS;Initial Catalog=FBS_Corresponsales_Solidarios_SanFranciscoAmbato</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>8ecbdefc-2e7a-4b69-a7b8-654ae1f865cd</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="IncidenciasAgente">
      <Query>
        <DataSourceName>DataSourceCorresponsales</DataSourceName>
        <CommandText>SELECT        Corresponsales.Alerta.Fecha, Nomenclador.Catalogo.Descripcion AS Incidencia, Corresponsales.Agente.NombreAgente, Corresponsales.Alerta.Descripcion, Corresponsales.Alerta.EstadoId
FROM            Corresponsales.Agente INNER JOIN
                         Corresponsales.Alerta ON Corresponsales.Agente.Id = Corresponsales.Alerta.AgenteId INNER JOIN
                         Nomenclador.Catalogo ON Corresponsales.Alerta.TipoId = Nomenclador.Catalogo.Id</CommandText>
      </Query>
      <Fields>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Incidencia">
          <DataField>Incidencia</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NombreAgente">
          <DataField>NombreAgente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EstadoId">
          <DataField>EstadoId</DataField>
          <rd:TypeName>System.Guid</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
